NODE_ENV=development
PORT=3077

MONGODB_URI=mongodb://host.docker.internal:27017/ccw?replicaSet=rs0
REDIS_URL=redis://host.docker.internal:6379

AUTH_SECRET=your_auth_secret
BASE_URL=http://localhost:3000
# Comma-separated list of origins to trust
#TRUSTED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com

# Microsoft Graph API
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# File storage
# Absolute path to directory where files are stored, defaults to ./uploads if unset
# Ensure directory is writable by Node process
FILE_UPLOAD_DIR=/var/ccw/uploads

# Contest timing
# How many minutes before startTime registration closes and provisioning begins
REGISTRATION_DEADLINE_MINUTES=1
# How many seconds before startTime the waiting room opens (prevents client-timer race condition)
ROOM_PRE_START_SECONDS=5
# How many seconds players have to click Ready before the contest is cancelled
READY_TIMEOUT_SECONDS=300

# Client configurations
# Disables long polling for notifications
NEXT_PUBLIC_DISABLE_NOTIFICATION_POLLING=true
# Rate limit (in seconds) for sync operations from the client
NEXT_PUBLIC_SYNC_COOLDOWN=5

# Match and connection timeouts
# Number of seconds a user can be disconnected before they forfeit the match
DISCONNECT_FORFEIT_TIMEOUT_SECONDS=60

# Mocking and Testing
# Set to true to use mocked Codeforces API responses during development
MOCK_CF_API=true
