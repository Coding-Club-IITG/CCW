NODE_ENV=development
PORT=3077

# Web and worker
MONGODB_URI=mongodb://host.docker.internal:27017/ccw?replicaSet=rs0
REDIS_URL=redis://host.docker.internal:6379

# Web
AUTH_SECRET=replace_with_a_random_secret_at_least_32_chars
BASE_URL=http://localhost:3000
# Comma-separated HTTP(S) origins to trust
TRUSTED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com

# Microsoft Graph API
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# Ops
OPS_LOGGING_ENABLED=false
OPS_LOG_INGEST_URL=http://host.docker.internal:3005/api/ingest/logs
OPS_LOG_INGEST_SECRET=replace_with_same_32_char_secret_as_ops

# Web Push (Optional)
# Generate a VAPID keypair with 'pnpm exec web-push generate-vapid-keys'
WEB_PUSH_PUBLIC_KEY=generated_public_key
WEB_PUSH_PRIVATE_KEY=generated_private_key
WEB_PUSH_SUBJECT=mailto:maintainer@yourdomain.com

# File storage
FILE_UPLOAD_DIR=./uploads/files
BLOG_UPLOAD_DIR=./uploads/blog
EVENT_UPLOAD_DIR=./uploads/events
PROJECT_UPLOAD_DIR=./uploads/projects
AVATAR_UPLOAD_DIR=./uploads/avatars

# POTD
# Jina Reader key used to fetch problem content (Optional)
JINA_API_KEY=your_jina_api_key

# Contests
# Minutes before startTime registration closes and provisioning begins
REGISTRATION_DEADLINE_MINUTES=3
# Seconds before startTime the waiting room opens
ROOM_PRE_START_SECONDS=5
# Seconds before forfeiture a user can be disconnected
DISCONNECT_FORFEIT_TIMEOUT_SECONDS=90
# Minutes players have to click Ready before contest is cancelled
ROOM_READY_TIMEOUT_MINUTES=2
# Rate limit (in seconds) for sync operations in rooms
SYNC_COOLDOWN=60

# Client configuration
# Disables long polling for notifications
NEXT_PUBLIC_DISABLE_NOTIFICATION_POLLING=false

# Testing
# Base URI to create ccw-test-*
MONGODB_TEST_URI=mongodb://127.0.0.1:27017
# Development
DEV_AUTH_ENABLED=false
DEV_MOCK_CF_SUBMISSIONS=false
DEV_DISABLE_USER_RATE_LIMITS=false
