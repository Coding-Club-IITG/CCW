{
  "name": "ccw",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev\" \"tsx src/worker.ts\"",
    "dev:web": "next dev",
    "worker": "tsx src/worker.ts",
    "build": "next build",
    "start": "concurrently -k -n web,worker -c cyan,magenta \"next start\" \"tsx src/worker.ts\"",
    "start:web": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "tsx tests/run-ci.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.5",
    "@agendajs/redis-backend": "^3.0.9",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@better-auth/mongo-adapter": "^1.7.27",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@coding-club-iitg/ops-logger": "^0.3.1",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@ronits2407/cp-api": "^1.2.0",
    "@xyflow/react": "^13.0.2",
    "agenda": "^6.2.8",
    "axios": "^1.21.1",
    "better-auth": "^1.7.27",
    "browsercc": "^0.1.1",
    "bullmq": "^6.7.8",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.78.0",
    "mdast-util-from-markdown": "^2.1.0",
    "monaco-editor": "0.58.0",
    "mongodb": "^7.9.1",
    "mongoose": "^9.12.3",
    "next": "^16.4.6",
    "pyodide": "^314.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-zoom-pan-pinch": "^4.4.0",
    "redis": "^6.3.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.1",
    "remark-math": "^6.0.0",
    "sass": "^1.108.2",
    "web-push": "^4.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "eventsource": "^5.1.5",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-native": "npm:typescript@^7.0.2",
    "vitest": "^5.1.1"
  }
